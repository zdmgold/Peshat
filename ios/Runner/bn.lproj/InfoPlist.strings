"CFBundleDisplayName" = "Peshat";
"NSCameraUsageDescription" = "Peshat পাঠ্য স্ক্যান এবং অনুবাদ করার জন্য ক্যামেরা ব্যবহার করে। ছবিগুলি ডিভাইসে প্রক্রিয়া করা হয় এবং আপলোড করা হয় না।";
"NSUserTrackingUsageDescription" = "আপনি অস্বীকার করলে প্রাসঙ্গিক অ-ব্যক্তিগতকৃত বিজ্ঞাপন দেখানোর জন্য ব্যবহৃত হয়; আপনি সম্মত হলে ব্যক্তিগতকৃত বিজ্ঞাপন।";
